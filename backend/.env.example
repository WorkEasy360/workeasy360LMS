# Copy to .env (or export these) before running the backend. Never commit real secrets.
# Every variable is documented in README.md §5.

APP_PROFILE=dev                 # dev = zero-install H2 file DB (PostgreSQL-compatibility mode). postgres = real PostgreSQL below.
SERVER_PORT=8080

JWT_SECRET=                     # REQUIRED outside the dev profile: random string, 32+ characters (e.g. `openssl rand -base64 48`). Never commit the real value.
JWT_EXPIRY_MINUTES=720

FILE_STORAGE_PATH=./storage     # uploaded videos (mount on shared storage for multi-node deployments)
MAX_VIDEO_MB=500                # hard upload limit; admins can lower it in Settings

CORS_ORIGINS=http://localhost:5173   # comma-separated frontend origins

# --- postgres profile ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=we360
DB_USERNAME=we360
DB_PASSWORD=we360

APP_SEED_ENABLED=false          # true = seed demo accounts/courses (known demo password) on an EMPTY database. Default: true on dev, false elsewhere. Never enable in production.

# --- AI course builder / quiz generator / learning coach ---
AI_ENABLED=false                # false = deterministic local mock provider (no external calls; what automated tests use)
AI_PROVIDER=mock                # mock | openai | anthropic
AI_API_KEY=                     # required when AI_ENABLED=true and provider != mock; never committed, never stored in the DB
AI_MODEL=                       # e.g. gpt-4o-mini / claude-sonnet-4-5
AI_BASE_URL=                    # optional: OpenAI-compatible gateway base URL
AI_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_QUESTIONS=25
AI_DEDUPE_MINUTES=10

# --- payments (course purchases) ---
PAYMENTS_PROVIDER=none          # none = paid courses cannot be purchased (safe default). mock = simulated checkout for LOCAL DEVELOPMENT ONLY.
PAYMENTS_MOCK_ALLOWED=false     # must be true for the mock provider to work; never set in production
PAYMENTS_API_KEY=               # for a real provider implementation of PaymentProvider; never committed
PAYMENTS_WEBHOOK_SECRET=        # for verifying a real provider's callbacks; never committed
PAYMENTS_CURRENCY=INR           # default currency for new course prices (INR | USD | EUR | GBP)

# --- outgoing e-mail (password resets + notification mails); leave SMTP_HOST empty to run without e-mail ---
SMTP_HOST=                      # e.g. smtp.eu.mailgun.org / smtp.gmail.com; empty = no e-mail, admin hands over reset links
SMTP_PORT=465                   # 465 = SSL (e.g. Hostinger, Gmail), 587 = STARTTLS
SMTP_USERNAME=
SMTP_PASSWORD=                  # never committed
SMTP_FROM=                      # defaults to SMTP_USERNAME
SMTP_STARTTLS=true              # used on port 587; port 465 uses implicit SSL automatically (override with SMTP_SSL)
APP_PUBLIC_URL=                 # absolute base for links in e-mails, e.g. https://lms.example.com
